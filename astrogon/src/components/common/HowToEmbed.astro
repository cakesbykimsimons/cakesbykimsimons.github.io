---
import type { HowTosEntry } from "@/types";
import StepImageLightbox from "@components/common/StepImageLightbox";
import EmbedMeta from "@components/guides/EmbedMeta.astro";
import EmbedCoverImage from "@components/guides/EmbedCoverImage.astro";
import EmbedNotes from "@components/guides/EmbedNotes.astro";
import { getCollection, render } from "astro:content";
import { markdownify, upperHumanize, slugify } from "@lib/textConverter";

interface Props {
  howToId: string;
}

const { howToId } = Astro.props;
const howTos = await getCollection("how-tos");
const howTo = howTos.find((h) => h.id === howToId);

if (!howTo) {
  throw new Error(`How-To "${howToId}" not found`);
}

const { Content } = await render(howTo);
const { title, author, description, image, imageAlt, skillLevel, timeRequired, cost, supplies, notes } = howTo.data;

// Assemble sidebar items for embed (like recipes)
const sidebarItems: Array<{
  icon?: string;
  label: string;
  value: string;
  href?: string;
}> = [];
if (author) {
  sidebarItems.push({
    icon: "user",
    label: "",
    value: upperHumanize(author.id),
    href: `/authors/${slugify(author.id)}`,
  });
}
if (skillLevel) {
  sidebarItems.push({ icon: "star", label: "", value: skillLevel });
}
if (timeRequired) {
  sidebarItems.push({ icon: "clock", label: "", value: timeRequired });
}
if (cost) {
  sidebarItems.push({ icon: "dollar", label: "", value: cost });
}
---

<div class="howto-embed my-6">
  <div class="glass rounded-lg p-4 md:p-6">
    <!-- Header: Title + Description -->
    <div class="flex flex-col md:flex-row gap-4 mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-bold text-txt-p dark:text-darkmode-txt-p m-0">
          {title}
        </h3>
        {
          description && (
            <p
              class="text-sm text-txt-s dark:text-darkmode-txt-s mt-1 mb-0"
              set:html={markdownify(description)}
            />
          )
        }
      </div>
      <!-- Meta sidebar -->
      {sidebarItems.length > 0 && <EmbedMeta items={sidebarItems} />}
    </div>

    <!-- Cover image -->
    <EmbedCoverImage src={image} alt={imageAlt || title} title={title} />

    <!-- Supplies -->
    {
      supplies && (supplies.list?.length > 0 || supplies.groups?.length > 0) && (
        <section class="mb-4">
          <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
            Supply List
          </h4>
          <div class="glass rounded-lg p-3">
            {supplies.groups
              ? supplies.groups.map((group) => (
                  <div class="mb-3 last:mb-0">
                    <p class="text-xs font-semibold text-txt-s dark:text-darkmode-txt-s mb-1 uppercase tracking-wide">
                      {group.label}
                    </p>
                    <div class="grid grid-cols-2 lg:grid-cols-3 gap-y-2">
                      {group.list.map((item: string) => (
                        <div class="text-sm text-txt-p dark:text-darkmode-txt-p">
                          {item}
                        </div>
                      ))}
                    </div>
                  </div>
                ))
              : (
                  <div class="grid grid-cols-2 lg:grid-cols-3 gap-y-2">
                    {supplies.list!.map((item: string) => (
                      <span class="text-sm text-txt-p dark:text-darkmode-txt-p">
                        {item}
                      </span>
                    ))}
                  </div>
                )}
          </div>
        </section>
      )
    }

    <!-- Instructions -->
    {
      Content && (
        <section class="mb-4">
          <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
            Instructions
          </h4>
          <div class="glass rounded-lg p-3">
            <div class="guide-instructions-body not-prose">
              <StepImageLightbox client:load>
                <Content />
              </StepImageLightbox>
            </div>
          </div>
        </section>
      )
    }

    <!-- Notes -->
    {notes && notes.length > 0 && (
      <section class="mb-4">
        <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
          Notes
        </h4>
        <EmbedNotes notes={notes} />
      </section>
    )}

    <!-- Link to full how-to -->
    <div class="mt-3 text-right">
      <a
        href={`/how-tos/${howTo.id}`}
        class="text-sm text-txt-s dark:text-darkmode-txt-s hover:text-txt-p dark:hover:text-darkmode-txt-p underline"
      >
        View full guide →
      </a>
    </div>
  </div>
</div>

<style>
  .howto-embed :global(h3) {
    margin-bottom: 0.25rem;
  }
  .howto-embed :global(h4) {
    margin-bottom: 0.5rem;
  }
</style>

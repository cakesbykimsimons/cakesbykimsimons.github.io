---
import type { RecipesEntry } from "@/types";
import StepImageLightbox from "@components/common/StepImageLightbox";
import EmbedMeta from "@components/guides/EmbedMeta.astro";
import EmbedCoverImage from "@components/guides/EmbedCoverImage.astro";
import EmbedNotes from "@components/guides/EmbedNotes.astro";
import { getCollection, render } from "astro:content";
import {
  upperHumanize,
  markdownify,
  replaceFractions,
} from "@lib/textConverter";

interface Props {
  recipeId: string;
}

const { recipeId } = Astro.props;
const recipes = await getCollection("recipes");
const recipe = recipes.find((r) => r.id === recipeId);

if (!recipe) {
  throw new Error(`Recipe "${recipeId}" not found`);
}

const { Content } = await render(recipe);
const {
  title,
  author,
  description,
  image,
  imageAlt,
  prepTime,
  cookTime,
  coolTime,
  servings,
  diet,
  ingredients,
  notes,
} = recipe.data;

const totalTime = (prepTime || 0) + (cookTime || 0) + (coolTime || 0);

// Assemble sidebar items for embed
const sidebarItems: Array<{
  icon?: string;
  label: string;
  value: string;
  href?: string;
}> = [];
if (author) {
  sidebarItems.push({
    icon: "user",
    label: "",
    value: upperHumanize(author.id),
    href: `/recipes/${recipe.id}`,
  });
}
if (prepTime) {
  sidebarItems.push({
    icon: "blender",
    label: "",
    value: `Prep: ${prepTime} minutes`,
  });
}
if (totalTime > 0) {
  sidebarItems.push({
    icon: "clock",
    label: "",
    value: `Total: ${totalTime} minutes`,
  });
}
if (servings) {
  sidebarItems.push({
    icon: "utensils",
    label: "",
    value: servings === 1 ? "1 serving" : `${servings} servings`,
  });
}
if (diet) {
  sidebarItems.push({ icon: "seedling", label: "", value: diet });
}
---

<div class="recipe-embed my-6">
  <div class="glass rounded-lg p-4 md:p-6">
    <!-- Header: Title + Description -->
    <div class="flex flex-col md:flex-row gap-4 mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-bold text-txt-p dark:text-darkmode-txt-p m-0">
          {title}
        </h3>
        {
          description && (
            <p
              class="text-sm text-txt-s dark:text-darkmode-txt-s mt-1 mb-0"
              set:html={markdownify(description)}
            />
          )
        }
      </div>
      <!-- About sidebar -->
      {sidebarItems.length > 0 && <EmbedMeta items={sidebarItems} />}
    </div>

    <!-- Cover image -->
    <EmbedCoverImage src={image} alt={imageAlt || title} title={title} />

    <!-- Ingredients -->
    {
      ingredients &&
        (ingredients.list?.length > 0 || ingredients.groups?.length > 0) && (
          <section class="mb-4">
            <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
              Ingredients
            </h4>
            <div class="glass rounded-lg p-3">
              {ingredients.groups
                ? ingredients.groups.map((group) => (
                    <div class="mb-3 last:mb-0">
                      <p class="text-xs font-semibold text-txt-s dark:text-darkmode-txt-s mb-1 uppercase tracking-wide">
                        {group.label}
                      </p>
                      {group.list.map((item: string, index: number) => (
                        <div class="flex justify-between items-center py-1.5 border-b border-border dark:border-darkmode-border last:border-0">
                          <span
                            class="text-sm text-txt-p dark:text-darkmode-txt-p"
                            set:html={replaceFractions(item)}
                          />
                          <span
                            class="text-sm text-txt-s dark:text-darkmode-txt-s whitespace-nowrap ml-4"
                            set:html={replaceFractions(group.qty[index])}
                          />
                        </div>
                      ))}
                    </div>
                  ))
                : ingredients.list!.map((item: string, index: number) => (
                    <div class="flex justify-between items-center py-1.5 border-b border-border dark:border-darkmode-border last:border-0">
                      <span
                        class="text-sm text-txt-p dark:text-darkmode-txt-p"
                        set:html={replaceFractions(item)}
                      />
                      <span
                        class="text-sm text-txt-s dark:text-darkmode-txt-s whitespace-nowrap ml-4"
                        set:html={replaceFractions(ingredients.qty![index])}
                      />
                    </div>
                  ))}
            </div>
          </section>
        )
    }

    <!-- Instructions -->
    {
      Content && (
        <section class="mb-4">
          <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
            Instructions
          </h4>
          <div class="glass rounded-lg p-3">
            <div class="guide-instructions-body not-prose">
              <StepImageLightbox client:load>
                <Content />
              </StepImageLightbox>
            </div>
          </div>
        </section>
      )
    }

    <!-- Notes -->
    {
      notes && notes.length > 0 && (
        <section class="mb-4">
          <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
            Notes
          </h4>
          <EmbedNotes notes={notes} />
        </section>
      )
    }

    <!-- Link to full recipe -->
    <div class="mt-3 text-right">
      <a
        href={`/recipes/${recipe.id}`}
        class="text-sm text-txt-s dark:text-darkmode-txt-s hover:text-txt-p dark:hover:text-darkmode-txt-p underline"
      >
        View full recipe →
      </a>
    </div>
  </div>
</div>

<style>
  .recipe-embed :global(h3) {
    margin-bottom: 0.25rem;
  }
  .recipe-embed :global(h4) {
    margin-bottom: 0.5rem;
  }
</style>

---
import type { RecipesEntry } from "@/types";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { upperHumanize, markdownify } from "@lib/textConverter";
import {
  FaRegClock,
  FaRegUserCircle,
  FaUtensils,
  FaSeedling,
  FaBlender,
} from "react-icons/fa";

interface Props {
  recipeId: string;
}

const { recipeId } = Astro.props;
const recipes = await getCollection("recipes");
const recipe = recipes.find((r) => r.id === recipeId);

if (!recipe) {
  throw new Error(`Recipe "${recipeId}" not found`);
}

const {
  title,
  author,
  description,
  image,
  imageAlt,
  prepTime,
  cookTime,
  coolTime,
  servings,
  diet,
  ingredients,
  instructions,
  notes,
} = recipe.data;

const totalTime = (prepTime || 0) + (cookTime || 0) + (coolTime || 0);
---

<div class="recipe-embed my-6">
  <div class="glass rounded-lg p-4 md:p-6">
    <!-- Header: Title + Author/Time info -->
    <div class="flex flex-col md:flex-row gap-4 mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-bold text-txt-p dark:text-darkmode-txt-p m-0">
          {title}
        </h3>
        {
          description && (
            <p
              class="text-sm text-txt-s dark:text-darkmode-txt-s mt-1 mb-0"
              set:html={markdownify(description)}
            />
          )
        }
      </div>
      <!-- About sidebar -->
      {
        author || totalTime > 0 || servings || diet ? (
          <div class="glass rounded-lg p-3 flex-shrink-0">
            {author && (
              <div class="flex items-center text-sm text-txt-s dark:text-darkmode-txt-s">
                <FaRegUserCircle className="mr-1.5 -mt-0.5 inline-block" />
                <a href={`/recipes/${recipe.id}`} class="hover:underline">
                  {upperHumanize(author.id)}
                </a>
              </div>
            )}
            {prepTime && (
              <div class="flex items-center text-sm text-txt-s dark:text-darkmode-txt-s">
                <FaBlender className="mr-1.5 -mt-0.5 inline-block" />
                Prep: {prepTime} minutes
              </div>
            )}
            {totalTime > 0 && (
              <div class="flex items-center text-sm text-txt-s dark:text-darkmode-txt-s">
                <FaRegClock className="mr-1.5 -mt-0.5 inline-block" />
                Total: {totalTime} minutes
              </div>
            )}
            {servings && (
              <div class="flex items-center text-sm text-txt-s dark:text-darkmode-txt-s">
                <FaUtensils className="mr-1.5 -mt-0.5 inline-block" />
                {servings === 1 ? "1 serving" : `${servings} servings`}
              </div>
            )}
            {diet && (
              <div class="flex items-center text-sm text-txt-s dark:text-darkmode-txt-s">
                <FaSeedling className="mr-1.5 -mt-0.5 inline-block" />
                {diet}
              </div>
            )}
          </div>
        ) : null
      }
    </div>

    <!-- Cover image -->
    {
      image && (
        <div class="mb-4 rounded-lg overflow-hidden">
          <Image
            class="w-full"
            src={image}
            alt={imageAlt || title}
            loading="lazy"
          />
        </div>
      )
    }

    <!-- Ingredients -->
    {
      ingredients &&
        (ingredients.list?.length > 0 || ingredients.groups?.length > 0) && (
          <section class="mb-4">
            <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
              Ingredients
            </h4>
            <div class="glass rounded-lg p-3">
              {ingredients.groups
                ? ingredients.groups.map((group) => (
                    <div class="mb-3 last:mb-0">
                      <p class="text-xs font-semibold text-txt-s dark:text-darkmode-txt-s mb-1 uppercase tracking-wide">
                        {group.label}
                      </p>
                      {group.list.map((item: string, index: number) => (
                        <div class="flex justify-between items-center py-1.5 border-b border-border dark:border-darkmode-border last:border-0">
                          <span
                            class="text-sm text-txt-p dark:text-darkmode-txt-p"
                            set:html={item}
                          />
                          <span
                            class="text-sm text-txt-s dark:text-darkmode-txt-s whitespace-nowrap ml-4"
                            set:html={group.qty[index]}
                          />
                        </div>
                      ))}
                    </div>
                  ))
                : ingredients.list!.map((item: string, index: number) => (
                    <div class="flex justify-between items-center py-1.5 border-b border-border dark:border-darkmode-border last:border-0">
                      <span
                        class="text-sm text-txt-p dark:text-darkmode-txt-p"
                        set:html={item}
                      />
                      <span
                        class="text-sm text-txt-s dark:text-darkmode-txt-s whitespace-nowrap ml-4"
                        set:html={ingredients.qty![index]}
                      />
                    </div>
                  ))}
            </div>
          </section>
        )
    }

    <!-- Instructions -->
    {
      instructions &&
        (Array.isArray(instructions) || instructions.groups?.length > 0) && (
          <section class="mb-4">
            <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
              Instructions
            </h4>
            <div class="glass rounded-lg p-3">
              {Array.isArray(instructions)
                ? instructions.map((step: string, index: number) => (
                    <div class="flex gap-3 py-2 border-b border-border dark:border-darkmode-border last:border-0">
                      <span class="flex-shrink-0 w-6 h-6 rounded-full bg-txt-p dark:bg-darkmode-txt-p text-white dark:text-darkmode-bg-p flex items-center justify-center text-xs font-bold">
                        {index + 1}
                      </span>
                      <span
                        class="text-sm text-txt-p dark:text-darkmode-txt-p pt-0.5"
                        set:html={step}
                      />
                    </div>
                  ))
                : instructions.groups.map((group, groupIndex: number) => (
                    <div class="mb-3 last:mb-0">
                      <div class="flex gap-3 items-center py-2 border-b border-border dark:border-darkmode-border">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-txt-p dark:bg-darkmode-txt-p text-white dark:text-darkmode-bg-p flex items-center justify-center text-xs font-bold">
                          {groupIndex + 1}
                        </span>
                        <span
                          class="text-sm font-semibold text-txt-p dark:text-darkmode-txt-p pt-0.5"
                          set:html={group.label}
                        />
                      </div>
                      {group.steps.length > 0 && (
                        <div class="ml-9 mt-2">
                          {group.steps.map(
                            (step: string, stepIndex: number) => (
                              <div class="flex gap-2 py-1.5 border-b border-border dark:border-darkmode-border last:border-0">
                                <span class="text-sm text-txt-s dark:text-darkmode-txt-s flex-shrink-0 pt-0.5">
                                  {stepIndex + 1}.
                                </span>
                                <span
                                  class="text-sm text-txt-p dark:text-darkmode-txt-p pt-0.5"
                                  set:html={step}
                                />
                              </div>
                            ),
                          )}
                        </div>
                      )}
                    </div>
                  ))}
            </div>
          </section>
        )
    }

    <!-- Notes -->
    {
      notes && notes.length > 0 && (
        <section class="mb-2">
          <h4 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p mb-2">
            Notes
          </h4>
          <div class="glass rounded-lg p-3">
            {notes.map((note: string) => (
              <div class="flex gap-2 py-1.5 border-b border-border dark:border-darkmode-border last:border-0">
                <span class="text-txt-s dark:text-darkmode-txt-s flex-shrink-0">
                  •
                </span>
                <span
                  class="text-sm text-txt-p dark:text-darkmode-txt-p"
                  set:html={note}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Link to full recipe -->
    <div class="mt-3 text-right">
      <a
        href={`/recipes/${recipe.id}`}
        class="text-sm text-txt-s dark:text-darkmode-txt-s hover:text-txt-p dark:hover:text-darkmode-txt-p underline"
      >
        View full recipe →
      </a>
    </div>
  </div>
</div>

<style>
  .recipe-embed :global(h3) {
    margin-bottom: 0.25rem;
  }
  .recipe-embed :global(h4) {
    margin-bottom: 0.5rem;
  }
</style>

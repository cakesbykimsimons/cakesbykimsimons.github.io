---
import BaseLayout from "@components/base/BaseLayout.astro";
import BlogCard from "@components/blog/Card.astro";
import Pagination from "@components/common/Pagination.astro";
import PageHeader from "@components/common/PageHeader.astro";
import BlogSidebar from "@components/blog/Sidebar.astro";
import ArtistCard from "@components/base/ArtistCard.astro";
import SidebarWithArtist from "@components/blog/SidebarWithArtist.astro";
import type { BlogEntry, SocialLinks } from "@/types";

interface Props {
  entryIndex: BlogEntry;
  entries: BlogEntry[];
  tags: string[];
  categories: string[];
  allCategories: string[];
  pageIndex: number;
  pageCount: number;
  collection?: string;
  basePath?: string;
  artistCard?: boolean;
  artistImage?: string;
  artistImageAlt?: string;
  objectPositionProp?: string;
  artistName?: string;
  artistTagline?: string;
  artistBio?: string;
  socialLinks?: SocialLinks;
}

const {
  entryIndex,
  entries,
  tags,
  categories,
  allCategories,
  pageIndex,
  pageCount,
  collection = "blog",
  basePath,
  artistCard = false,
  artistImage,
  artistImageAlt,
  objectPositionProp,
  artistName = "Kim Simons",
  artistTagline = "Multi-award winning master cake artist & Food Network Champion",
  artistBio,
  socialLinks,
} = Astro.props;
---

<BaseLayout
  title={entryIndex.data.title}
  description={entryIndex.data.description}
>
  <PageHeader title={entryIndex.data.title} />
  <section class="section">
    <div class="flex container">
      <div class="row px-0 mx-0 w-full">
        <!-- blog posts -->
        <div class="col-12 lg:col-8 lg:p-0">
          <Fragment>
            {artistCard && pageIndex <= 1 && artistBio && (
              <div class="mb-4 lg:hidden">
                <ArtistCard
                  image={artistImage}
                  imageAlt={artistImageAlt}
                  objectPositionProp={objectPositionProp}
                  name={artistName}
                  tagline={artistTagline}
                  bio={artistBio}
                  socialLinks={socialLinks}
                />
              </div>
            )}
          </Fragment>
          {entries.map((entry) => (
            <div class="mb-4">
              <BlogCard entry={entry} />
            </div>
          ))}
          <Pagination
            collection={collection}
            basePath={basePath}
            pageIndex={pageIndex}
            pageCount={pageCount}
          />
        </div>
        <!-- sidebar -->
        <div
          class="hidden lg:col-4 lg:flex max-h-static_sidemenu sticky p-0 pl-4 top-[4rem]"
        >
          {
            artistCard ? (
              <SidebarWithArtist
                tags={tags}
                categories={categories}
                allCategories={allCategories}
                artistImage={artistImage}
                artistImageAlt={artistImageAlt}
                objectPositionProp={objectPositionProp}
                artistName={artistName}
                artistTagline={artistTagline}
                artistBio={artistBio}
                socialLinks={socialLinks}
              />
            ) : (
              <BlogSidebar
                tags={tags}
                categories={categories}
                allCategories={allCategories}
              />
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

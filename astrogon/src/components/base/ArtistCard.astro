---
import { markdownify } from "@lib/textConverter";
import Social from "@components/common/Social.astro";
import type { SocialLinks } from "@/types";
import { Image } from "astro:assets";

interface Props {
  image?: string;
  imageAlt?: string;
  objectPositionProp?: string;
  name: string;
  tagline: string;
  bio: string;
  socialLinks?: SocialLinks;
}

const {
  image,
  imageAlt,
  objectPositionProp = "top center",
  name,
  tagline,
  bio,
  socialLinks,
} = Astro.props;
---

<div class="glass rounded-lg p-4 intersect:animate-fadeLeft opacity-0">
  <h4 class="text-center mb-3">{name}</h4>
  <div class="flex flex-col sm:flex-row items-center gap-4">
    {
      image && (
        <div class="shrink-0 flex flex-col items-center sm:items-start gap-2">
          <Image
            class="rounded-full w-24 h-24 sm:w-28 sm:h-28 object-cover border-2 border-border dark:border-darkmode-border"
            style={`object-position: ${objectPositionProp};`}
            src={image}
            alt={imageAlt}
            width={200}
            height={200}
            loading="lazy"
          />
          {socialLinks && (
            <div class="flex justify-center sm:justify-start">
              <Social links={socialLinks} />
            </div>
          )}
        </div>
      )
    }
    <div class="text-center sm:text-left">
      <p class="text-sm text-txt-p dark:text-darkmode-txt-p mb-2">{tagline}</p>
      <p
        class="text-sm text-txt-p dark:text-darkmode-txt-p mb-3"
        set:html={markdownify(bio)}
      />
    </div>
  </div>
</div>

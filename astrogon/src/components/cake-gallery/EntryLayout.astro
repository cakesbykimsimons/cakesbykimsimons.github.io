---
import GalleryEntryLayout from "@components/gallery/EntryLayout.astro";
import type { CakeGalleryEntry, MenuItem } from "@/types";

interface Props {
  entry: CakeGalleryEntry;
  browserMenu: MenuItem[];
}

const { entry, browserMenu } = Astro.props;
---

<GalleryEntryLayout
  entry={entry}
  browserMenu={browserMenu}
  basePath="cake-gallery"
  browserTitle="Cake Gallery"
/>

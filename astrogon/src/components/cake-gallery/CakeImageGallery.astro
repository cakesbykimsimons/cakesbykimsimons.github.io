---
import { getImagesForCake, type CakeImage } from "@lib/galleryUtils";

interface Props {
  entryId: string;
}

const { entryId } = Astro.props;
const images: CakeImage[] = await getImagesForCake(entryId);
---

<div class="gallery-masonry">
  {images.map((image: CakeImage) => (
    <div class="gallery-item">
      <div class="glass rounded-lg p-3">
        <img
          src={image.src}
          alt={image.caption}
          class="w-full rounded"
          loading="lazy"
        />
      </div>
      {image.caption && (
        <div class="mt-2 text-center text-sm glass px-3 py-2 rounded-lg">
          {image.caption}
        </div>
      )}
    </div>
  ))}
</div>

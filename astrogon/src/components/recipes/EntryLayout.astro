---
import type { RecipesEntry } from "@/types";
import Share from "@components/common/Share.astro";
import StepImageLightbox from "@components/common/StepImageLightbox";
import { Image } from "astro:assets";
import BaseLayout from "@components/base/BaseLayout.astro";
import {
  upperHumanize,
  markdownify,
  slugify,
  replaceFractions,
} from "@lib/textConverter";
import { render } from "astro:content";

import {
  FaRegClock,
  FaRegUserCircle,
  FaUtensils,
  FaSeedling,
  FaBlender,
} from "react-icons/fa";

interface Props {
  entry: RecipesEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  author,
  description,
  image,
  imageAlt,
  prepTime,
  cookTime,
  coolTime,
  servings,
  diet,
  ingredients,
  notes,
} = entry.data;

const totalTime = (prepTime || 0) + (cookTime || 0) + (coolTime || 0);
---

<BaseLayout title={title} description={description} image={image?.src}>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <article class="lg:col-10 flex flex-wrap content-start">
          <!-- Title -->
          <h1 set:html={title} class="p-2 col basis-full min-w-72" />
          <!-- Cover Photo -->
          {
            image && (
              <div class="col basis-2/3 p-2 min-w-72">
                <div class="glass rounded-lg intersect:animate-fadeDown opacity-0">
                  <Image
                    class="w-full rounded-lg"
                    src={image}
                    alt={imageAlt}
                    width={1920}
                    height={1080}
                    loading="eager"
                  />
                </div>
              </div>
            )
          }
          <!-- About -->
          <section class="col basis-1/3 p-2 min-w-72">
            <div
              class="glass rounded-lg p-2 h-full intersect:animate-fadeUp opacity-0"
            >
              <!-- Author -->
              {
                author && (
                  <div class="m-4">
                    <a href={`/authors/${slugify(author.id)}`}>
                      <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
                      {upperHumanize(author.id)}
                    </a>
                  </div>
                )
              }
              <!-- Prep Time -->
              {
                prepTime && (
                  <div class="m-4">
                    <FaBlender className={"mr-2 -mt-1 inline-block"} />
                    Prep: {prepTime} minutes
                  </div>
                )
              }
              <!-- Total Time -->
              {
                totalTime > 0 && (
                  <div class="m-4">
                    <FaRegClock className={"mr-2 -mt-1 inline-block"} />
                    Total: {totalTime} minutes
                  </div>
                )
              }
              <!-- Servings -->
              {
                servings && (
                  <div class="m-4">
                    <FaUtensils className={"mr-2 -mt-1 inline-block"} />
                    {servings === 1 ? "1 serving" : servings + " servings"}
                  </div>
                )
              }
              <!-- Diet -->
              {
                diet && (
                  <div class="m-4">
                    <FaSeedling className={"mr-2 -mt-1 inline-block"} />
                    {diet}
                  </div>
                )
              }
              <!-- Description -->
              {
                description && (
                  <div>
                    {author || totalTime > 0 || servings || diet ? (
                      <hr class="my-2" />
                    ) : null}
                    <div class="m-4">
                      <div set:html={markdownify(description)} />
                    </div>
                  </div>
                )
              }
            </div>
          </section>
          <!-- Ingredients -->
          {
            ingredients && (
              <section class="col basis-1/3 p-2 min-w-72">
                <div class="glass rounded-lg p-4 intersect:animate-fadeUp opacity-0">
                  <h2 set:html="Ingredients" class="mb-2" />
                  {ingredients.groups ? (
                    ingredients.groups.map((group) => (
                      <div class="mb-3">
                        <h3
                          set:html={group.label}
                          class="text-sm font-semibold mb-1"
                        />
                        <div class="row justify-center">
                          {group.list.map((it: string, index: number) => (
                            <div class="row my-1">
                              <div
                                class="col-7"
                                set:html={replaceFractions(group.list[index])}
                              />
                              <div
                                class="col-5 text-right"
                                set:html={replaceFractions(group.qty[index])}
                              />
                              <hr class="my-1" />
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  ) : (
                    <div class="row justify-center">
                      {ingredients.list!.map((it: string, index: number) => (
                        <div class="row my-1">
                          <div
                            class="col-7"
                            set:html={replaceFractions(
                              ingredients.list![index],
                            )}
                          />
                          <div
                            class="col-5 text-right"
                            set:html={replaceFractions(ingredients.qty![index])}
                          />
                          <hr class="my-1" />
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </section>
            )
          }
          <!-- Instructions -->
          {
            Content && (
              <section class="col basis-full p-2 min-w-72">
                <div class="glass rounded-lg p-4 intersect:animate-fadeUp opacity-0">
                  <h2 set:html="Instructions" class="mb-2" />
                  <div class="recipe-instructions-body not-prose">
                    <StepImageLightbox client:load>
                      <Content />
                    </StepImageLightbox>
                  </div>
                </div>
              </section>
            )
          }
          <!-- Notes -->
          {
            notes && (
              <section class="col basis-full p-2 min-w-72">
                <div class="glass rounded-lg p-4 intersect:animate-fadeUp opacity-0">
                  <h2 set:html="Notes" class="mb-2" />
                  <div class="row justify-center">
                    {notes.map((it: string, index: number) => (
                      <div class="row my-1">
                        <div class="col">{replaceFractions(it)}</div>
                        <hr class="my-1" />
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            )
          }
        </article>
        <!-- Share -->
        <div
          class="flex col-10 p-2 items-center justify-center lg:justify-end px-6"
        >
          <Share
            title={title}
            description={description}
            folder="recipes"
            id={entry.id}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

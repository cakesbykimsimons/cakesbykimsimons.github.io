---
import type { CakeGalleryEntry, MenuItem } from "@/types";
import EntryLayout from "@components/cake-gallery/EntryLayout.astro";
import CollectionLayout from "@components/cake-gallery/CollectionLayout.astro";
import {
  getEntries,
  getAllChildrenInGroup,
  buildMenuTree,
} from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";

export async function getStaticPaths() {
  const entries = (await getEntries(
    "cakeGallery",
    sortByTitle,
  )) as CakeGalleryEntry[];

  const paths = entries.map((entry) => {
    const cleanId = entry.id.replace("/-index", "");
    const segments = cleanId.split("/");

    return {
      params: { id: cleanId },
      props: { entry, isGroup: entry.id.endsWith("/-index") },
    };
  });

  return paths;
}

const { entry, isGroup } = Astro.props;
const groupName = entry.id.replace("/-index", "");
const groupEntries = isGroup
  ? ((await getAllChildrenInGroup(
      "cakeGallery",
      groupName,
      sortByTitle,
    )) as CakeGalleryEntry[])
  : [];

// Construct Doc Browser menu recursively
const browserMenu = await buildMenuTree("cakeGallery", sortByTitle);
---

{
  isGroup ? (
    <CollectionLayout collectionIndex={entry} entries={groupEntries} />
  ) : (
    <EntryLayout entry={entry} browserMenu={browserMenu} />
  )
}

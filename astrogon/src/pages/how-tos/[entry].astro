---
import type { HowTosEntry } from "@/types";
import EntryLayout from "@components/how-tos/EntryLayout.astro";
import { getEntries } from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";

export async function getStaticPaths() {
  const entries = (await getEntries("how-tos", sortByTitle)) as HowTosEntry[];
  const paths = entries.map((entry) => ({
    params: {
      entry: entry.id,
    },
    props: { entry },
  }));
  return paths;
}

const { entry } = Astro.props;
---

<EntryLayout entry={entry} />
